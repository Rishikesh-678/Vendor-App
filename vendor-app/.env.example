# Copy to .env and fill in. Never commit .env.

# --- Database (used by the db container and to build DATABASE_URL) ---
POSTGRES_DB=vendors
POSTGRES_USER=vendors
POSTGRES_PASSWORD=change-me

# --- Backend ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:8080
# Set to false only for local development over plain http.
COOKIE_SECURE=true

# --- Frontend (nginx) ---
# Interface and port the app is published on. Use 0.0.0.0 to accept connections from
# other machines (put TLS in front first, and keep COOKIE_SECURE=true).
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
